{
  "Logging": {
    "MinimumLevel": "Debug",
    "Directory": "logs",
    "RetainedFileCount": 14
  },
  "ExternalSources": {
    "MappingsPath": "external-sources.json",
    "CacheRoot": "cache",
    "RefreshIntervalMinutes": 60,
    "MaxDiskBytes": 536870912,
    "MaxMemoryBytes": 536870912,
    "MaxParallelOperations": 4,
    "MaxResidentResources": 128,
    "IdleTtlMinutes": 45
  },
  "AssemblyAnalysis": {
    "CacheRoot": "cache/asm",
    "DecompilationTimeoutSeconds": 180
  }
}
