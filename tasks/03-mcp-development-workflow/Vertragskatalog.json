{
  "version": 1,
  "status": "normative",
  "target": {
    "required": { "targetPath": "absolute-existing-sln-or-slnx" },
    "origin": "derived-from-targetPath-extension",
    "forbidden": ["targetType", "projectRoot", "configPath", "solutionPath"]
  },
  "navigation": {
    "required": ["target", "origin", "snapshot", "capabilities", "operationStatus", "result", "completeness", "next"],
    "statuses": ["ok", "invalid_argument", "target_mismatch", "stale_snapshot", "not_configured", "unsupported", "not_decidable", "error"],
    "completeness": ["complete", "empty", "partial", "truncated", "not_configured", "not_decidable", "not_applicable", "unsupported"],
    "nextKinds": ["none", "refine_scope", "change_direction", "request_detail", "continue"]
  },
  "workflow": {
    "get_feature_context": {
      "required": ["targetPath", "symbolIdentifier"],
      "optional": { "maxCallers": 10, "maxTests": 10 },
      "sections": ["declaration", "impact", "testContext", "violations", "metrics"],
      "evidenceBoundary": "static-analysis-only"
    },
    "get_impact": {
      "required": ["targetPath"],
      "modes": ["symbol", "git-change-context"],
      "symbolInput": "symbolIdentifier",
      "evidenceBoundary": "static-references-or-git-diff-only"
    },
    "get_test_context": {
      "required": ["targetPath", "symbolIdentifier"],
      "optional": { "maxResults": 30 },
      "evidenceBoundary": "static-test-candidates-only"
    },
    "get_violations": {
      "required": ["targetPath"],
      "optional": { "scopeFilter": null, "ruleId": null, "minSeverity": null, "maxResults": 50 },
      "missingRules": "not_configured"
    },
    "metrics_lookup": {
      "required": ["targetPath", "symbolIdentifiers"],
      "inputType": "array-of-symbol-identifiers"
    }
  },
  "precision": {
    "safeguard": {
      "required": ["targetPath"],
      "missingRules": "not_configured",
      "scoreIsNotScope": true,
      "configuredFileFilters": "outside-effective-scope-and-reported",
      "allMatchingDocumentsExcluded": "not_decidable"
    },
    "pattern_detect": { "required": ["targetPath"], "perCategoryStatus": true },
    "find_dead_code": { "required": ["targetPath"], "resultType": "candidate", "deletionClaim": false },
    "find_duplicates": { "required": ["targetPath"], "resultType": "candidate", "deletionClaim": false },
    "find_magic_values": { "required": ["targetPath"], "categoriesDisjoint": true }
  },
  "hardCut": {
    "unknownInput": "invalid_argument",
    "aliases": "forbidden",
    "legacyRuntimeFallback": false,
    "legacyDocs": false
  },
  "budgets": { "compositeBytes": 12288, "sectionBytes": 4096 }
}
