<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Transitive Abhängigkeit von Microsoft.CodeAnalysis.Workspaces.MSBuild:
       MSBuild.Locator 1.11+ verlangt ExcludeAssets="runtime" und PrivateAssets="all",
       damit keine MSBuild-Runtime ins Output kopiert wird. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.StringTools">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
