<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1.0.165</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="ExCSS" />
    <PackageReference Include="ICSharpCode.Decompiler" />
    <PackageReference Include="Esprima" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\README.md" LogicalName="README.md" />
    <EmbeddedResource Include="..\..\Docs\integration.md" LogicalName="Docs/integration.md" />
    <EmbeddedResource Include="..\..\Docs\agent-api.md" LogicalName="Docs/agent-api.md" />
    <EmbeddedResource Include="..\..\Docs\configuration.md" LogicalName="Docs/configuration.md" />
    <EmbeddedResource Include="..\..\Docs\rationale.md" LogicalName="Docs/rationale.md" />
    <EmbeddedResource Include="..\..\Docs\ROADMAP.md" LogicalName="Docs/ROADMAP.md" />
    <EmbeddedResource Include="..\..\Docs\mcp-bootstrap.md" LogicalName="Docs/mcp-bootstrap.md" />
    <EmbeddedResource Include="..\..\rules.json" LogicalName="rules.json" />
    <EmbeddedResource Include="..\..\.agents\rules\AiNetLinter-McpWorkflow.mdc" LogicalName="AgentRules/AiNetLinter-McpWorkflow.mdc" />
  </ItemGroup>

  <ItemGroup>
    <!-- System-Logging- und External-Sources-Konfiguration: bewusst als lose Datei ausgeliefert (nicht eingebettet),
         damit sie im Deployment ohne Neubuild angepasst werden kann. -->
    <Content Include="..\..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\external-sources.json" Link="external-sources.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
