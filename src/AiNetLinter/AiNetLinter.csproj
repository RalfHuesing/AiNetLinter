<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1.0.199</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="ExCSS" />
    <PackageReference Include="ICSharpCode.Decompiler" />
    <PackageReference Include="Esprima" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\README.md" LogicalName="README.md" />
    <EmbeddedResource Include="..\..\Docs\linter\configuration.md" LogicalName="Docs/linter/configuration.md" />
    <EmbeddedResource Include="..\..\Docs\linter\cli.md" LogicalName="Docs/linter/cli.md" />
    <EmbeddedResource Include="..\..\Docs\linter\integration.md" LogicalName="Docs/linter/integration.md" />
    <EmbeddedResource Include="..\..\Docs\mcp\tools.md" LogicalName="Docs/mcp/tools.md" />
    <EmbeddedResource Include="..\..\Docs\mcp\server.md" LogicalName="Docs/mcp/server.md" />
    <EmbeddedResource Include="..\..\Docs\mcp\integration.md" LogicalName="Docs/mcp/integration.md" />
    <EmbeddedResource Include="..\..\Docs\mcp\mcp-bootstrap.md" LogicalName="Docs/mcp/mcp-bootstrap.md" />
    <EmbeddedResource Include="..\..\Docs\rationale.md" LogicalName="Docs/rationale.md" />
    <EmbeddedResource Include="..\..\ainetlinter-rules.json" LogicalName="ainetlinter-rules.json" />
    <EmbeddedResource Include="..\..\.agents\rules\AiNetLinter-McpWorkflow.mdc" LogicalName="AgentRules/AiNetLinter-McpWorkflow.mdc" />
  </ItemGroup>

  <ItemGroup>
    <!-- System-Logging-Konfiguration: bewusst als lose Datei ausgeliefert (nicht eingebettet),
         damit sie im Deployment ohne Neubuild angepasst werden kann. -->
    <Content Include="..\..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
